{
  "name": "factory-reference-billing-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Reference TypeScript billing API — tenant-scoped invoice export, OpenAPI compatibility demo",
  "license": "Apache-2.0",
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "start": "tsx src/server.ts",
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "test": "vitest run",
    "test:e2e": "vitest run test/e2e",
    "openapi:validate": "npx @redocly/cli lint openapi/openapi.yaml"
  },
  "dependencies": {
    "fastify": "^4.28.0",
    "@fastify/jwt": "^8.0.0",
    "@fastify/postgres": "^6.1.0",
    "pg": "^8.12.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "typescript": "^5.5.0",
    "tsx": "^4.16.0",
    "vitest": "^2.0.0"
  }
}
